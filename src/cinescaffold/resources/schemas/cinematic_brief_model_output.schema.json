{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinescaffold.local/schemas/cinematic_brief_model_output.schema.json",
  "title": "Cinematic Brief Model Output v0.8",
  "type": "object",
  "properties": {
    "summary": {"type": "string"},
    "subjects": {
      "type": "array",
      "items": {"$ref": "#/$defs/subject"}
    },
    "subject_motion": {
      "type": "array",
      "items": {"$ref": "#/$defs/subjectMotion"}
    },
    "scene_dynamics": {"$ref": "#/$defs/sceneDynamics"},
    "scene_design": {"$ref": "#/$defs/sceneDesign"},
    "mood": {"$ref": "#/$defs/mood"},
    "composition": {"$ref": "#/$defs/composition"},
    "camera": {"$ref": "#/$defs/camera"},
    "timeline": {"$ref": "#/$defs/timeline"},
    "uncertainties": {
      "type": "array",
      "items": {"$ref": "#/$defs/uncertainty"}
    }
  },
  "required": [
    "summary",
    "subjects",
    "subject_motion",
    "scene_dynamics",
    "scene_design",
    "mood",
    "composition",
    "camera",
    "timeline",
    "uncertainties"
  ],
  "additionalProperties": false,
  "$defs": {
    "sourceStatus": {
      "type": "string",
      "enum": ["explicit", "inferred", "default", "unknown"]
    },
    "sourceEvidence": {
      "description": "[SEM-SOURCE-EVIDENCE] explicit/inferred 必须携带非空最小原文证据；default/unknown 的 source_text 必须为 null；存在 value 时 unknown 还要求 value=null。",
      "oneOf": [
        {
          "properties": {
            "source_status": {"type": "string", "enum": ["explicit", "inferred"]},
            "source_text": {"type": "string", "minLength": 1}
          }
        },
        {
          "properties": {
            "source_status": {"type": "string", "const": "default"},
            "source_text": {"type": "null"}
          }
        },
        {
          "properties": {
            "source_status": {"type": "string", "const": "unknown"},
            "source_text": {"type": "null"},
            "value": {"type": "null"}
          }
        }
      ]
    },
    "annotatedText": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "value": {"type": ["string", "null"]},
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": ["value", "source_status", "source_text"],
      "additionalProperties": false
    },
    "annotatedUnknown": {
      "type": "object",
      "properties": {
        "value": {"type": "null"},
        "source_status": {"type": "string", "const": "unknown"},
        "source_text": {"type": "null"}
      },
      "required": ["value", "source_status", "source_text"],
      "additionalProperties": false
    },
    "annotatedScreenHorizontal": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "value": {"type": ["string", "null"], "enum": [null, "left", "center", "right"]},
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": ["value", "source_status", "source_text"],
      "additionalProperties": false
    },
    "annotatedScreenVertical": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "value": {"type": ["string", "null"], "enum": [null, "top", "center", "bottom"]},
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": ["value", "source_status", "source_text"],
      "additionalProperties": false
    },
    "annotatedPercentageRange": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "value": {
          "type": ["string", "null"],
          "pattern": "^\\s*\\d+(?:\\.\\d+)?\\s*%(?:\\s*-\\s*\\d+(?:\\.\\d+)?\\s*%)?\\s*$"
        },
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": ["value", "source_status", "source_text"],
      "additionalProperties": false
    },
    "annotatedVisibilityRequirement": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "value": {"type": ["string", "null"], "enum": [null, "keep_in_frame"]},
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": ["value", "source_status", "source_text"],
      "additionalProperties": false
    },
    "annotatedCameraViewAngle": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "value": {"type": ["string", "null"], "enum": [null, "eye_level", "high_angle", "low_angle", "top_down"]},
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": ["value", "source_status", "source_text"],
      "additionalProperties": false
    },
    "annotatedCameraHeight": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "value": {"type": ["string", "null"], "pattern": "^\\s*\\d+(?:\\.\\d+)?\\s*(?:m|米)\\s*$"},
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": ["value", "source_status", "source_text"],
      "additionalProperties": false
    },
    "annotatedLensIntent": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "value": {"type": ["string", "null"], "pattern": "^(?:\\s*\\d+(?:\\.\\d+)?\\s*mm\\s*|wide|normal|telephoto)$"},
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": ["value", "source_status", "source_text"],
      "additionalProperties": false
    },
    "annotatedCameraMovement": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "value": {
          "type": ["string", "null"],
          "enum": [null, "static", "pan", "orbit", "push_in", "pull_out", "follow", "lateral"]
        },
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": ["value", "source_status", "source_text"],
      "additionalProperties": false
    },
    "semanticStatement": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "value": {"type": "string"},
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": ["value", "source_status", "source_text"],
      "additionalProperties": false
    },
    "attribute": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "name": {"type": "string"},
        "value": {"type": "string"},
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": ["name", "value", "source_status", "source_text"],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "category": {"$ref": "#/$defs/annotatedText"},
        "description": {"$ref": "#/$defs/annotatedText"},
        "narrative_role": {"$ref": "#/$defs/annotatedText"},
        "attributes": {
          "type": "array",
          "items": {"$ref": "#/$defs/attribute"}
        }
      },
      "required": ["id", "category", "description", "narrative_role", "attributes"],
      "additionalProperties": false
    },
    "subjectMotion": {
      "type": "object",
      "properties": {
        "motion_id": {"type": "string"},
        "subject_id": {"type": "string"},
        "action": {"$ref": "#/$defs/annotatedText"},
        "motion_semantics": {"$ref": "#/$defs/motionSemantics"},
        "direction": {"$ref": "#/$defs/annotatedText"},
        "speed": {"$ref": "#/$defs/annotatedText"},
        "trajectory": {"$ref": "#/$defs/annotatedText"},
        "start_time_seconds": {"type": "number"},
        "end_time_seconds": {"type": "number"},
        "secondary_motion": {
          "type": "array",
          "maxItems": 0,
          "items": {"$ref": "#/$defs/semanticStatement"}
        }
      },
      "required": [
        "motion_id",
        "subject_id",
        "action",
        "motion_semantics",
        "direction",
        "speed",
        "trajectory",
        "start_time_seconds",
        "end_time_seconds",
        "secondary_motion"
      ],
      "additionalProperties": false
    },
    "motionSemantics": {
      "type": "object",
      "description": "[SEM-MOTION-COMBINATION] 每个场景实体动作阶段的类型化语义；事件参与者不自动成为几何运动目标。motion_mode 必须与 action_kind、motion_type、path_type、local_components、direction_mode、target_id 和 carrier_id 使用下列合法组合。",
      "allOf": [
        {"$ref": "#/$defs/sourceEvidence"},
        {
          "description": "[SEM-MOTION-COMBINATION] motion_mode 对应的动作、路径、局部通道和载体组合。",
          "oneOf": [
            {
              "properties": {
                "motion_mode": {"const": "stationary"},
                "action_kind": {"const": "hold"},
                "motion_type": {"const": "static"},
                "path_type": {"const": "stationary"},
                "local_components": {"type": "array", "maxItems": 0},
                "carrier_id": {"type": "null"}
              }
            },
            {
              "properties": {
                "motion_mode": {"const": "local_interaction"},
                "action_kind": {"const": "interact"},
                "motion_type": {"const": "interactive"},
                "path_type": {"const": "stationary"},
                "local_components": {"type": "array", "minItems": 1},
                "carrier_id": {"type": "null"}
              }
            },
            {
              "properties": {
                "motion_mode": {"const": "self_propelled"},
                "action_kind": {"const": "locomotion"},
                "motion_type": {"enum": ["walking", "running", "flying", "jumping", "moving"]},
                "path_type": {"enum": ["linear", "circular", "elliptical", "s_curve", "figure_eight", "parabolic", "unspecified"]},
                "local_components": {"type": "array", "maxItems": 0},
                "carrier_id": {"type": "null"}
              }
            },
            {
              "properties": {
                "motion_mode": {"const": "carried"},
                "action_kind": {"const": "locomotion"},
                "motion_type": {"const": "carried"},
                "direction_mode": {"const": "none"},
                "target_id": {"type": "null"},
                "carrier_id": {"type": "string", "minLength": 1},
                "path_type": {"const": "stationary"},
                "local_components": {"type": "array", "maxItems": 0}
              }
            }
          ]
        },
        {
          "description": "[SEM-MOTION-COMBINATION] direction_mode 与 target_id 的组合。",
          "oneOf": [
            {
              "properties": {
                "direction_mode": {"enum": ["none", "world_forward", "world_left", "world_right"]},
                "target_id": {"type": "null"}
              }
            },
            {
              "properties": {
                "direction_mode": {"enum": ["toward_target", "away_from_target", "relative_to_target"]},
                "target_id": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        {
          "description": "[SEM-MOTION-COMBINATION] 闭合相对路径与目标的组合。",
          "oneOf": [
            {
              "properties": {
                "path_type": {"enum": ["circular", "elliptical"]},
                "direction_mode": {"const": "relative_to_target"},
                "target_id": {"type": "string", "minLength": 1}
              }
            },
            {
              "properties": {
                "path_type": {"enum": ["stationary", "linear", "s_curve", "figure_eight", "parabolic", "unspecified"]}
              }
            }
          ]
        }
      ],
      "properties": {
        "action_kind": {
          "type": "string",
          "enum": ["hold", "locomotion", "interact", "other"]
        },
        "motion_type": {
          "type": "string",
          "enum": [
            "static", "interactive", "walking", "running", "flying",
            "jumping", "moving", "carried"
          ]
        },
        "motion_mode": {
          "type": "string",
          "enum": ["stationary", "self_propelled", "carried", "local_interaction"]
        },
        "direction_mode": {
          "type": "string",
          "description": "只有明确几何方向才使用非 none；动作参与者和事件参与者不自动成为几何目标。",
          "enum": [
            "none", "world_forward", "world_left", "world_right",
            "toward_target", "away_from_target",
            "relative_to_target"
          ]
        },
        "target_id": {"type": ["string", "null"]},
        "carrier_id": {"type": ["string", "null"]},
        "path_type": {
          "type": "string",
          "enum": [
            "stationary", "linear", "circular", "elliptical", "s_curve",
            "figure_eight", "parabolic", "unspecified"
          ]
        },
        "local_components": {
          "type": "array",
          "description": "local_interaction 实际改变的通道；其他 motion_mode 必须为空数组。",
          "items": {"type": "string", "enum": ["rotation", "scale"]},
          "uniqueItems": true,
          "maxItems": 2
        },
        "timeline_event_id": {"type": ["string", "null"]},
        "narrative_required": {"type": "boolean"},
        "postconditions": {"$ref": "#/$defs/motionPostconditions"},
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": [
        "action_kind", "motion_type", "motion_mode", "direction_mode",
        "target_id", "carrier_id", "path_type", "local_components", "timeline_event_id",
        "narrative_required", "postconditions", "source_status", "source_text"
      ],
      "additionalProperties": false
    },
    "motionPostconditions": {
      "type": "object",
      "properties": {
        "contained_by_id": {"type": ["string", "null"]},
        "external_visibility": {
          "type": "string",
          "description": "动作阶段造成的可见性转变，不是阶段结束时的静态可见状态。",
          "enum": ["unchanged", "becomes_visible", "becomes_hidden"]
        }
      },
      "required": ["contained_by_id", "external_visibility"],
      "additionalProperties": false
    },
    "sceneDynamics": {
      "type": "object",
      "description": "只分类场景实体状态：场景实体的位置、姿态、尺度、可见性或容纳关系发生变化才是 dynamic；摄影机运动和环境效果均不计入。",
      "properties": {
        "mode": {"type": "string", "enum": ["static", "dynamic"]},
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "reason": {"type": "string"}
      },
      "required": ["mode", "source_status", "reason"],
      "additionalProperties": false
    },
    "spatialLayer": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "layer": {"type": "string"},
        "content_ids": {"type": "array", "items": {"type": "string"}},
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": ["layer", "content_ids", "source_status", "source_text"],
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "description": "[SEM-RELATION-EVENT] subject_id 始终是满足关系谓词的对象，reference_id 是参照对象。timeline_event_id=null 只允许 throughout；at_start/at_midpoint/at_end 必须引用事件。far_from 表示 subject 在摄影机纵深上比 reference 更远且二者有世界空间净空；scale_dominance 只表示 subject 的投影尺寸大于 reference，不表示物理尺寸。其他方向关系使用规范世界坐标，不表示屏幕左右上下。",
      "allOf": [
        {"$ref": "#/$defs/sourceEvidence"},
        {
          "description": "[SEM-RELATION-EVENT] timeline_event_id 与 temporal_mode 的组合。",
          "oneOf": [
            {
              "properties": {
                "timeline_event_id": {"type": "null"},
                "temporal_mode": {"const": "throughout"}
              }
            },
            {
              "properties": {
                "timeline_event_id": {"type": "string", "minLength": 1},
                "temporal_mode": {"enum": ["throughout", "at_start", "at_midpoint", "at_end"]}
              }
            }
          ]
        }
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "far_from", "proximity", "scale_dominance",
            "left_of", "right_of", "front_of", "behind", "above", "below"
          ]
        },
        "subject_id": {"type": "string"},
        "reference_id": {"type": "string"},
        "timeline_event_id": {
          "type": ["string", "null"],
          "description": "关系发生在任意时刻或区间时，必须引用 timeline.events 中带数值时间的事件；只有全视频片段关系才为 null。"
        },
        "temporal_mode": {
          "type": "string",
          "description": "throughout 表示覆盖所引用事件的整个任意时间区间；仅当 timeline_event_id 为 null 时才表示全视频片段。at_start/at_midpoint/at_end 只约束事件的开始、中央或结束采样。",
          "enum": ["throughout", "at_start", "at_midpoint", "at_end"]
        },
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": [
        "type", "subject_id", "reference_id",
        "timeline_event_id", "temporal_mode", "source_status", "source_text"
      ],
      "additionalProperties": false
    },
    "sceneDesign": {
      "type": "object",
      "properties": {
        "environment": {"$ref": "#/$defs/annotatedText"},
        "spatial_layers": {"type": "array", "items": {"$ref": "#/$defs/spatialLayer"}},
        "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
        "environmental_motion": {"type": "array", "items": {"$ref": "#/$defs/semanticStatement"}}
      },
      "required": ["environment", "spatial_layers", "relationships", "environmental_motion"],
      "additionalProperties": false
    },
    "mood": {
      "type": "object",
      "properties": {
        "emotional_tones": {"type": "array", "items": {"$ref": "#/$defs/semanticStatement"}},
        "color_intent": {"type": "array", "items": {"$ref": "#/$defs/semanticStatement"}},
        "lighting_intent": {"type": "array", "items": {"$ref": "#/$defs/semanticStatement"}},
        "atmosphere": {"type": "array", "items": {"$ref": "#/$defs/semanticStatement"}}
      },
      "required": ["emotional_tones", "color_intent", "lighting_intent", "atmosphere"],
      "additionalProperties": false
    },
    "screenPlacement": {
      "type": "object",
      "description": "代码可执行的规范屏幕区域；horizontal 仅用 left/center/right，vertical 仅用 top/center/bottom。",
      "properties": {
        "subject_id": {"type": "string"},
        "horizontal": {"$ref": "#/$defs/annotatedScreenHorizontal"},
        "vertical": {"$ref": "#/$defs/annotatedScreenVertical"}
      },
      "required": ["subject_id", "horizontal", "vertical"],
      "additionalProperties": false
    },
    "visualScale": {
      "type": "object",
      "description": "场景实体投影高度占画面的百分比或百分比范围，例如 20% 或 20%-30%。",
      "properties": {
        "subject_id": {"type": "string"},
        "scale": {"$ref": "#/$defs/annotatedPercentageRange"}
      },
      "required": ["subject_id", "scale"],
      "additionalProperties": false
    },
    "visibilityRequirement": {
      "type": "object",
      "description": "当前 requirement 只支持 keep_in_frame。",
      "properties": {
        "subject_id": {"type": "string"},
        "requirement": {"$ref": "#/$defs/annotatedVisibilityRequirement"}
      },
      "required": ["subject_id", "requirement"],
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "properties": {
        "shot_size": {"$ref": "#/$defs/annotatedUnknown"},
        "patterns": {"type": "array", "maxItems": 0, "items": {"$ref": "#/$defs/semanticStatement"}},
        "screen_placements": {"type": "array", "items": {"$ref": "#/$defs/screenPlacement"}},
        "visual_scales": {"type": "array", "items": {"$ref": "#/$defs/visualScale"}},
        "visibility_requirements": {"type": "array", "items": {"$ref": "#/$defs/visibilityRequirement"}}
      },
      "required": ["shot_size", "patterns", "screen_placements", "visual_scales", "visibility_requirements"],
      "additionalProperties": false
    },
    "cameraMovement": {
      "type": "object",
      "description": "[SEM-CAMERA-MOVEMENT-TARGET] 只描述摄影机自身的位置、朝向或焦距变化。pan/follow/orbit 必须填写 target_id；其他类型必须为 null。",
      "allOf": [
        {
          "description": "[SEM-CAMERA-MOVEMENT-TARGET] 摄影机运动类型与 target_id 的组合。",
          "oneOf": [
            {
              "properties": {
                "type": {
                  "properties": {"value": {"enum": ["pan", "follow", "orbit"]}}
                },
                "target_id": {"type": "string", "minLength": 1}
              }
            },
            {
              "properties": {
                "type": {
                  "properties": {"value": {"enum": [null, "static", "push_in", "pull_out", "lateral"]}}
                },
                "target_id": {"type": "null"}
              }
            }
          ]
        }
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/annotatedCameraMovement",
          "description": "代码直接执行的封闭运镜类型；固定位置旋转跟踪使用 pan，不得写成随场景实体平移的 follow。"
        },
        "target_id": {
          "type": ["string", "null"],
          "description": "pan/follow/orbit 的摄影机运动目标场景实体 ID；没有目标时为 null。"
        },
        "direction": {"$ref": "#/$defs/annotatedUnknown"},
        "speed": {"$ref": "#/$defs/annotatedText"},
        "trajectory": {"$ref": "#/$defs/annotatedUnknown"},
        "easing": {"$ref": "#/$defs/annotatedUnknown"},
        "start_time_seconds": {"type": ["number", "null"]},
        "end_time_seconds": {"type": ["number", "null"]}
      },
      "required": ["type", "target_id", "direction", "speed", "trajectory", "easing", "start_time_seconds", "end_time_seconds"],
      "additionalProperties": false
    },
    "cameraViewRelation": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "value": {
          "type": "string",
          "enum": ["front", "rear", "side", "three_quarter", "unspecified"]
        },
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": ["value", "source_status", "source_text"],
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "shot_type": {"$ref": "#/$defs/annotatedUnknown"},
        "view_angle": {"$ref": "#/$defs/annotatedCameraViewAngle"},
        "view_relation_to_motion": {"$ref": "#/$defs/cameraViewRelation"},
        "camera_height": {"$ref": "#/$defs/annotatedCameraHeight", "description": "明确值使用米制数值，例如 1.6 m。"},
        "lens_intent": {"$ref": "#/$defs/annotatedLensIntent", "description": "明确值使用毫米焦距或 wide/normal/telephoto。"},
        "focus_target_id": {"$ref": "#/$defs/annotatedText"},
        "movement": {"$ref": "#/$defs/cameraMovement"}
      },
      "required": ["shot_type", "view_angle", "view_relation_to_motion", "camera_height", "lens_intent", "focus_target_id", "movement"],
      "additionalProperties": false
    },
    "timelineEvent": {
      "type": "object",
      "description": "[SEM-TEMPORAL-INTEGRITY][SEM-REFERENCE-INTEGRITY] 事件可位于视频片段内任意有效数值时间区间，用作动作和空间关系的共享时间锚点；ID 和引用必须有效且唯一。",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string"},
        "start_time_seconds": {"type": "number"},
        "end_time_seconds": {"type": "number"},
        "reference_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": ["id", "description", "start_time_seconds", "end_time_seconds", "reference_ids", "source_status", "source_text"],
      "additionalProperties": false
    },
    "temporalRelation": {
      "type": "object",
      "description": "[SEM-TEMPORAL-INTEGRITY][SEM-REFERENCE-INTEGRITY] 时间关系的事件引用、枚举、数值区间和可选间隔必须互相一致。",
      "allOf": [{"$ref": "#/$defs/sourceEvidence"}],
      "properties": {
        "relation_id": {"type": "string"},
        "source_event_id": {"type": "string"},
        "target_event_id": {"type": "string"},
        "relation": {
          "type": "string",
          "enum": ["before", "after", "meets", "overlaps", "during", "starts_before", "starts_after", "starts_with", "ends_with"]
        },
        "minimum_gap_seconds": {"type": ["number", "null"]},
        "maximum_gap_seconds": {"type": ["number", "null"]},
        "source_status": {"$ref": "#/$defs/sourceStatus"},
        "source_text": {"type": ["string", "null"]}
      },
      "required": [
        "relation_id", "source_event_id", "target_event_id", "relation",
        "minimum_gap_seconds", "maximum_gap_seconds", "source_status", "source_text"
      ],
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "properties": {
        "duration_seconds": {"type": ["number", "null"]},
        "duration_range_seconds": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "minimum_seconds": {"type": "number"},
                "maximum_seconds": {"type": "number"}
              },
              "required": ["minimum_seconds", "maximum_seconds"],
              "additionalProperties": false
            },
            {"type": "null"}
          ]
        },
        "duration_source_status": {"$ref": "#/$defs/sourceStatus"},
        "events": {"type": "array", "items": {"$ref": "#/$defs/timelineEvent"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/temporalRelation"}}
      },
      "required": ["duration_seconds", "duration_range_seconds", "duration_source_status", "events", "relations"],
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "description": "[SEM-UNCERTAINTY-RESOLUTION] unresolved 必须配 selected_value=null；use_default/use_inference 必须配非空 selected_value，记录实际采用值。field 必须非空且在数组中唯一。",
      "oneOf": [
        {
          "properties": {
            "resolution": {"const": "unresolved"},
            "selected_value": {"type": "null"}
          }
        },
        {
          "properties": {
            "resolution": {"enum": ["use_default", "use_inference"]},
            "selected_value": {"type": "string", "minLength": 1}
          }
        }
      ],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "resolution": {"type": "string", "enum": ["unresolved", "use_default", "use_inference"]},
        "selected_value": {"type": ["string", "null"]}
      },
      "required": ["field", "reason", "resolution", "selected_value"],
      "additionalProperties": false
    }
  }
}
